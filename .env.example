# Gemini API Key (required)
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Configuration
FLASK_ENV=development
PORT=5000

# Optional: Datadog Configuration (for production telemetry)
# DD_API_KEY=your_datadog_api_key
# DD_APP_KEY=your_datadog_app_key
# DD_SERVICE=cdi-sentinel
# DD_ENV=production

# Optional: Confluent Kafka Configuration (for event streaming)
# KAFKA_BOOTSTRAP_SERVERS=your_kafka_servers
# KAFKA_API_KEY=your_kafka_api_key
# KAFKA_API_SECRET=your_kafka_api_secret

# Optional: ElevenLabs Configuration (for voice synthesis)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key
# ELEVENLABS_VOICE_ID=Cordelia_v2
